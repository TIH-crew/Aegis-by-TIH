# Local edge function secrets (copy to supabase/functions/.env — never commit)
# Used by: npm run dev:functions

# Local: http://localhost:1420 — Production: https://aegis-by-tih.vercel.app
AEGIS_APP_URL=http://localhost:1420
# AEGIS_REQUEST_SECRET=optional-for-dev

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# ZOHO_API_DOMAIN=www.zohoapis.com
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# When serving against a remote Supabase project (default dev setup):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# VerifyNow.co.za (drivers licence, licence disc, number plate)
VERIFYNOW_API_KEY=vn_live_your_key_here

# AEGIS_APP_URL=https://aegis-by-tih.vercel.app

# Employee claim WhatsApp OTP (Twilio Verify preferred)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# Optional fallback sender, e.g. whatsapp:+14155238886
# TWILIO_WHATSAPP_FROM=
# Broker notify destination for submitted employee claims (E.164)
# Default handler: Jan van den Berg
# BROKER_WHATSAPP_TO=+27825487070
# BROKER_HANDLER_NAME=Jan van den Berg
# Optional: Zoho CRM user email to assign as claim Owner
# BROKER_HANDLER_EMAIL=

# Vapi (server only — never expose in Vite / Vercel VITE_* vars)
# Used by aegis-employee-claim POST /vapi/complete to fetch call artifact + recording
VAPI_PRIVATE_KEY=
# Optional: Structured Output UUID attached to the claims assistant
# VAPI_CLAIM_STRUCTURED_OUTPUT_ID=
