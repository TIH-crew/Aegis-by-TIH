# Portal (Vite) — copy to .env
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Vapi Web Calling (public key only — never put a Vapi private/server key in the frontend)
VITE_VAPI_PUBLIC_KEY=your_vapi_public_key
VITE_VAPI_ASSISTANT_ID=your_assistant_id

# Optional: point CRM calls at locally served edge functions (npm run dev:functions)
# VITE_SUPABASE_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1

# Zoho + edge function secrets — copy supabase/functions/.env.example → supabase/functions/.env
# Local dev: npm run dev:functions (reads supabase/functions/.env; no Dashboard secrets needed)
# Production: set the same keys in Supabase Dashboard → Edge Functions → Secrets
